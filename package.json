{
  "name": "our-kaisen",
  "version": "1.0.0",
  "description": "Discord bot for game management and interactions",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build:start": "npm run build && npm run start",
    "deploy": "npm run build && node dist/deploy-commands.js",
    "deploy:global": "npm run build && node dist/deploy-commands.js --global",
    "lint": "biome lint src tests scripts",
    "lint:fix": "biome lint --write src tests scripts",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "test:watch": "node scripts/test-watch.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc"
  },
  "keywords": [
    "discord",
    "bot",
    "game"
  ],
  "author": "Your Name",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "discord-api-types": "^0.38.50",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
